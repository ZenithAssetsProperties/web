# syntax=docker/dockerfile:1.7

# ==============================================================================
# Zenith Asset Group - High-Performance Development Dockerfile
# Optimized for fast hot module reloading, Turbo compilation, and volume mounting
# ==============================================================================

FROM node:20-alpine AS dev
WORKDIR /app

# System dependencies for native modules and health checks
RUN apk add --no-cache libc6-compat wget git

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate

# Set development environment
ENV NODE_ENV=development
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"
ENV WATCHPACK_POLLING=true

# Copy package descriptors first to maximize layer caching
COPY package.json pnpm-lock.yaml ./

# Install development dependencies
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install

# Copy application source code
COPY . .

EXPOSE 3000

# Continuous development container health validation
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:3000/api/health || exit 1

# Start Next.js development server with Turbopack binding to all network interfaces
CMD ["pnpm", "dev", "--hostname", "0.0.0.0"]

