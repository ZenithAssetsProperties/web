# Public, frontend-only site config. Never put secrets in NEXT_PUBLIC_* vars
# they are inlined into the client bundle at build time.

NEXT_PUBLIC_SITE_URL=https://www.zenithassetgroup.com
NEXT_PUBLIC_SITE_NAME="Zenith Asset Group"

# Live chat (tawk.to) — leave blank to keep the chat widget disabled.
# Get both from tawk.to: Administration > Channels > Chat Widget, out of the
# embed URL https://embed.tawk.to/<propertyId>/<widgetId>
NEXT_PUBLIC_TAWK_TO_PROPERTY_ID=
NEXT_PUBLIC_TAWK_TO_WIDGET_ID=
